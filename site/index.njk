---
layout: layout.njk
permalink: /
---
<section class="intro">
  <h1 class="title">Things I’ve <span class="accent">built</span><span class="dot">.</span></h1>
  <p class="lede">{{ site.description }}</p>
  <p class="legend">
    {% for s in site.statuses %}<a class="status status-{{ s.status }}" href="/search/?status={{ s.status }}" title="{{ s.description }}">{{ s.label }} {{ s.count }}</a> {% endfor %}
  </p>
</section>
{#- Each list is an h-feed of its things' h-entries (thing-row.njk, feature-card.njk), named by its heading. A
    featured thing is in its collection's feed too: the same entry in two feeds, never one inside another. #}
{% if site.featured.length %}
<section class="featured h-feed" aria-labelledby="featured">
  <h2 id="featured" class="p-name">Featured</h2>
  <ul class="feature-list">
    {% for feature in site.featured %}{% include "feature-card.njk" %}{% endfor %}
  </ul>
</section>
{% endif %}
{% if site.stories.length %}
<section class="stories" aria-labelledby="stories">
  <h2 id="stories">Stories</h2>
  <p class="muted">Ideas I kept coming back to, told across the things they became.</p>
  <ul class="story-list">
    {% for story in site.stories %}{% include "story-card.njk" %}{% endfor %}
  </ul>
</section>
{% endif %}
{% for collection in site.collections %}
<section class="collection h-feed" id="{{ collection.name | slugify }}">
  <h2><span class="p-name">{{ collection.name }}</span> <span class="count badge">{{ collection.things | length }}</span></h2>
  <ul class="thing-list">
    {% for thing in collection.things %}{% include "thing-row.njk" %}{% endfor %}
  </ul>
</section>
{% endfor %}
<section class="topics-summary">
  <h2>Topics</h2>
  <p class="topic-cloud">
    {% for topic in site.topics %}<a href="{{ topic.page }}">{{ topic.title }} <span class="count">{{ topic.things | length }}</span></a> {% endfor %}
  </p>
</section>
