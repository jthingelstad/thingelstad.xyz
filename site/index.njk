---
layout: layout.njk
permalink: /
---
<section class="intro">
  <h1 class="title">Things I’ve <span class="accent">built</span><span class="dot">.</span></h1>
  <p class="lede">{{ site.description }}</p>
  <p class="legend">
    {% for s in site.statuses %}<a class="status status-{{ s.status }}" href="/search/?status={{ s.status }}" title="{{ s.description }}">{{ s.label }} {{ s.count }}</a> {% endfor %}
  </p>
</section>
{% if site.featured.length %}
<section class="featured" aria-labelledby="featured">
  <h2 id="featured">Featured</h2>
  <ul class="feature-list">
    {% for thing in site.featured %}{% include "feature-card.njk" %}{% endfor %}
  </ul>
</section>
{% endif %}
{% for collection in site.collections %}
<section class="collection" id="{{ collection.name | slugify }}">
  <h2>{{ collection.name }} <span class="count badge">{{ collection.things | length }}</span></h2>
  <ul class="thing-list">
    {% for thing in collection.things %}{% include "thing-row.njk" %}{% endfor %}
  </ul>
</section>
{% endfor %}
<section class="topics-summary">
  <h2>Topics</h2>
  <p class="topic-cloud">
    {% for topic in site.topics %}<a href="{{ topic.page }}">{{ topic.title }} <span class="count">{{ topic.things | length }}</span></a> {% endfor %}
  </p>
</section>
