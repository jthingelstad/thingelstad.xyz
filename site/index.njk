---
layout: layout.njk
permalink: /
---
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p class="lede">{{ site.description }}</p>
  <p class="legend">
    {% for s in site.statuses %}<span class="status status-{{ s.status }}" title="{{ s.description }}">{{ s.label }} {{ s.count }}</span> {% endfor %}
  </p>
</section>
{% for collection in site.collections %}
<section class="collection" id="{{ collection.name | slugify }}">
  <h2>{{ collection.name }} <span class="count">{{ collection.things | length }}</span></h2>
  <ul class="thing-list">
    {% for thing in collection.things %}{% include "thing-row.njk" %}{% endfor %}
  </ul>
</section>
{% endfor %}
<section class="topics-summary">
  <h2>Topics</h2>
  <p class="topic-cloud">
    {% for topic in site.topics %}<a href="{{ topic.page }}">{{ topic.title }} <span class="count">{{ topic.things | length }}</span></a> {% endfor %}
  </p>
</section>
