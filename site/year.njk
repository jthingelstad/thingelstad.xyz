---
layout: layout.njk
pagination:
  data: site.years
  size: 1
  alias: y
permalink: '{{ y.page }}'
eleventyComputed:
  title: '{{ y.year }}'
  description: 'Jamie Thingelstad’s projects in {{ y.year }}: {{ y.line }}.'
---
{% from "macros.njk" import shelf, thingCard %}
{#- One year (collection/years.ts): what started, what ended, what happened, and the work behind it. The whole
    ledger is here with no script; site/js/enhance.js adds the filter by kind. #}
{% set a = site.activity %}
<section class="year-head">
  <div>
    <p class="crumbs"><a href="/years/">Years</a></p>
    <h1 class="year-number">{{ y.year }}</h1>
    <p class="lede">{{ y.line }}</p>
  </div>
  <nav class="year-nav" aria-label="Other years">
    {%- if y.older %}<a class="year-chip" href="/years/{{ y.older }}/" rel="prev">← {{ y.older }}</a>{% endif %}
    {%- if y.newer %}<a class="year-chip" href="/years/{{ y.newer }}/" rel="next">{{ y.newer }} →</a>{% endif -%}
  </nav>
</section>
{% if y.started.length %}
{% call shelf("started", "Started in " + y.year, y.started.length + (" things" if y.started.length != 1 else " thing"), 244, null, null, true) %}
  {% for thing in y.started %}{{ thingCard(thing, owner) }}{% endfor %}
{% endcall %}
{% endif %}
{% if y.ended.length %}
<section class="year-section" id="ended">
  <h2>Ended in {{ y.year }}</h2>
  <p class="year-tags">{% for thing in y.ended %}<a class="tag" href="{{ thing.page }}">{{ thing.title }}</a> {% endfor %}</p>
</section>
{% endif %}
{% if y.already.length %}
<section class="year-section" id="already">
  <h2>Already alive</h2>
  <p class="year-tags">{% for thing in y.already %}<a class="tag" href="{{ thing.page }}">{{ thing.title }}</a> {% endfor %}</p>
</section>
{% endif %}
{% if y.work %}
<section class="year-section" id="work">
  <h2>The work</h2>
  <div class="work-tiles">
    {% for tile in y.tiles %}<div class="work-tile"><span class="work-count">{{ tile.count | number }}</span><span class="small">{{ tile.label }}</span></div>
    {% endfor %}
  </div>
  <p class="meta">A commit is with an agent when an agent authored it or signed it with a co-author line, or when one of Jamie’s agents made it under its own name. Codex seldom signs its commits, so much of its work counts as Jamie’s here. Bots’ commits, dependency updates and the collector’s own, are left out.{% if y.weeks.length %} <a href="#weeks">Week by week</a>.{% endif %}</p>
  {% if y.work.things.length %}
  <p class="activity-tally">
    {%- for t in y.work.things %}<a href="{{ t.page }}">{{ t.title }}</a> <span class="muted">{% if t.commits %}{{ t.commits | number }}{% if t.publications %} + {{ t.publications | number }}{% endif %}{% else %}{{ t.publications | number }} {{ 'post' if t.publications == 1 else 'posts' }}{% endif %}</span>{% if not loop.last %} · {% endif %}{% endfor -%}
  </p>
  <p class="meta">Commits, then publications. A thing’s commits are those in its own repositories, or in its directory of one it shares.</p>
  {% endif %}
</section>
{% endif %}
{% if y.events.length %}
<section class="year-section" id="ledger" data-filter-scope>
  <div class="shelf-head">
    <h2>What happened</h2>
    {% if y.kinds.length > 1 %}<div class="filter-chips" role="group" aria-label="Filter by kind" data-filter-axis="kind" data-enhanced hidden>
      <button class="filter-chip" type="button" data-value="" aria-pressed="true">All</button>
      {% for k in y.kinds %}<button class="filter-chip" type="button" data-value="{{ k.kind }}" aria-pressed="false">{{ k.kind }} <span class="count">{{ k.count }}</span></button>
      {% endfor %}
    </div>{% endif %}
  </div>
  <ol class="ledger">
    {% for event in y.events %}
    <li class="ledger-event" id="{{ event.id }}" data-filter-item data-filters="kind:{{ event.kind }} ">
      <p class="ledger-when"><time datetime="{{ event.date }}">{{ event.date | date }}</time><span class="meta">{{ event.kind }}</span></p>
      <div>
        <h3>{{ event.title }}</h3>
        <p class="small">{{ event.summary }} <a href="{{ event.source | ref("source") }}">Source</a></p>
        <p class="year-tags">{% for id in event.things %}{% set other = site | thing(id) %}<a class="tag" href="{{ other.page }}">{{ other.title }}</a> {% endfor %}</p>
      </div>
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}
{% if y.weeks.length %}
<section class="year-section activity-weeks" id="weeks">
  <h2>Week by week</h2>
  {% if a.collected %}<p class="muted">The newest twelve weeks, collected daily, most recently {{ a.collected | localDay | day }}. Follow along: <a href="/activity.xml">RSS</a>, one item for each day with activity.</p>{% endif %}
  {% for week in y.weeks %}
  <section class="week" id="{{ week.id }}">
    <h3>Week of {{ week.start | day }}{% if week.current %} <span class="badge">so far</span>{% endif %}</h3>
    {% if week.things | length %}
    <p class="muted">{{ week | activitySummary }}, in {{ week.things | length }} {{ 'thing' if (week.things | length) == 1 else 'things' }}.</p>
    <ul class="activity-list">
      {% for entry in week.things %}{% include "activity-entry.njk" %}{% endfor %}
    </ul>
    {% else %}
    <p class="muted">Nothing landed this week.</p>
    {% endif %}
  </section>
  {% endfor %}
</section>
{% endif %}
<script type="module" src="{{ assets.enhance }}"></script>
