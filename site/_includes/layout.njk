<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fffcf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171512" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="{{ description or site.description }}" />
    <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v={{ assets.favicon }}" />
    {#- The type every one of Jamie's sites shares (site/css/shared/, vendored from thingelstad.com shared/):
        the two faces every page sets first, preloaded, then the --jt- tokens, then this site's own look. #}
    {% for href in assets.fontPreloads %}<link rel="preload" href="{{ href }}" as="font" type="font/woff2" crossorigin />
    {% endfor %}<link rel="stylesheet" href="{{ assets.tokens }}" />
    <link rel="stylesheet" href="{{ assets.css }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} History" href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.title }} History" href="/feed.json" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} Activity" href="/activity.xml" />
    {% if markdownTwin %}<link rel="alternate" type="text/markdown" href="{{ markdownTwin }}" />{% endif %}
    {% for href in owner.rel_me %}<link rel="me" href="{{ href }}" />
    {% endfor %}
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    {#- A thing's page shares its own screenshot, or none; every other page this site's front page. #}
    {%- if thing and thing.page == page.url %}{% set share = thing.screenshot %}{% else %}{% set share = site.screenshot %}{% endif %}
    {% if share %}
    <meta property="og:image" content="{{ site.url }}{{ share.src }}" />
    <meta property="og:image:width" content="{{ share.width }}" />
    <meta property="og:image:height" content="{{ share.height }}" />
    <meta property="og:image:alt" content="{{ share.alt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    {% else %}
    <meta name="twitter:card" content="summary" />
    {% endif %}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {% include "sites-strip.njk" %}
    <header class="site-header">
      <a class="wordmark" href="/"><span class="mark" aria-hidden="true">T</span>{{ site.title }}</a>
      <nav aria-label="Site">
        <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Things</a>
        <a href="/topics/"{% if page.url.startsWith('/topics/') %} aria-current="page"{% endif %}>Topics</a>
        <a href="/history/"{% if page.url == '/history/' %} aria-current="page"{% endif %}>History</a>
        <a href="/activity/"{% if page.url == '/activity/' %} aria-current="page"{% endif %}>Activity</a>
        <a href="/timeline/"{% if page.url == '/timeline/' %} aria-current="page"{% endif %}>Timeline</a>
        <a href="/search/"{% if page.url == '/search/' %} aria-current="page"{% endif %}>Search</a>
      </nav>
    </header>
    <main id="main" class="site-main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>
        {#- Jamie's h-card, the same on every one of Jamie's sites (thingelstad.com AGENTS.md, "Jamie on every site"). Identity links stay clean: no ref. #}
        Everything I’ve built, by
        <a class="h-card" href="{{ owner.url }}" rel="me author"><img class="u-photo" src="{{ owner.avatar }}" alt="" width="24" height="24" /><span class="p-name">{{ owner.name }}</span><data class="u-url" value="{{ owner.url }}"></data><data class="p-note" value="{{ owner.note }}"></data></a>, kept as
        <a href="{{ site.repository }}">Markdown and YAML</a>. Status is my decision. Activity is evidence. <a href="/about/">About this site</a>.
      </p>
      <p>
        <a href="/feed.xml">RSS</a> · <a href="/feed.json">JSON Feed</a> · <a href="/activity.xml">Activity RSS</a> · <a href="/llms.txt">llms.txt</a> ·
        <a href="/things.json">things.json</a> · <a href="{{ site.repository }}">Source</a>
      </p>
    </footer>
    <script src="https://tinylytics.app/embed/jyQF-tKd4sG-MEeyxvik.js" defer></script>
  </body>
</html>
