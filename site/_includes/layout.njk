<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="{{ description or site.description }}" />
    <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="{{ assets.css }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} History" href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title="{{ site.title }} History" href="/feed.json" />
    {% if markdownTwin %}<link rel="alternate" type="text/markdown" href="{{ markdownTwin }}" />{% endif %}
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">{{ site.title }}</a>
      <nav aria-label="Site">
        <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Things</a>
        <a href="/topics/"{% if page.url.startsWith('/topics/') %} aria-current="page"{% endif %}>Topics</a>
        <a href="/history/"{% if page.url == '/history/' %} aria-current="page"{% endif %}>History</a>
        <a href="/timeline/"{% if page.url == '/timeline/' %} aria-current="page"{% endif %}>Timeline</a>
      </nav>
    </header>
    <main id="main" class="site-main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>
        An index of what <a href="https://www.thingelstad.com/">Jamie Thingelstad</a> has built, kept as
        <a href="{{ site.repository }}">Markdown and YAML</a>. Status is a decision; activity is evidence.
      </p>
      <p>
        <a href="/feed.xml">RSS</a> · <a href="/feed.json">JSON Feed</a> · <a href="/llms.txt">llms.txt</a> ·
        <a href="/things.json">things.json</a> · <a href="{{ site.repository }}">Source</a>
      </p>
    </footer>
    <script src="https://tinylytics.app/embed/jyQF-tKd4sG-MEeyxvik.js?spa" defer></script>
  </body>
</html>
