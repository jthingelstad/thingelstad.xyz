{
  "name": "thingelstad.xyz",
  "version": "0.1.0",
  "private": true,
  "description": "Things I’ve built. An index and archive of my projects, by Jamie Thingelstad.",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run site:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && stylelint site/css/site.css && knip",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "templates": "node infra/templates.mjs",
    "deploy": "node scripts/deploy.mjs",
    "collect": "tsx scripts/collect.ts",
    "site:build": "NODE_OPTIONS=--import=tsx eleventy --config=site/eleventy.config.ts",
    "site:serve": "NODE_OPTIONS=--import=tsx eleventy --config=site/eleventy.config.ts --serve --port=8080"
  },
  "keywords": [],
  "author": "Jamie Thingelstad",
  "type": "module",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "pele": "1.6.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "markdown-it": "^15.0.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
