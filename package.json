{
  "name": "thingelstad.xyz",
  "version": "0.1.0",
  "private": true,
  "description": "Things I’ve built. An index and archive of Jamie Thingelstad’s projects.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run collection:build && npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run site:build && npm run editor:build",
    "package": "npm run check && node infra/templates.mjs && node scripts/package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && stylelint src/styles.css editor/editor.css site/css/site.css && knip",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "deploy": "node scripts/deploy.mjs",
    "editor:build": "vite build --config vite.editor.config.ts",
    "editor": "tsx server/editor-index.ts",
    "test:editor": "playwright test --config playwright.editor.config.ts",
    "collection:build": "tsx scripts/build-collection.ts",
    "collect": "tsx scripts/collect.ts",
    "site:build": "NODE_OPTIONS=--import=tsx eleventy --config=site/eleventy.config.ts",
    "site:serve": "NODE_OPTIONS=--import=tsx eleventy --config=site/eleventy.config.ts --serve --port=8080"
  },
  "keywords": [],
  "author": "Jamie Thingelstad",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1150.0",
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@aws-sdk/client-sts": "^3.1150.0",
    "@aws-sdk/credential-providers": "^3.1150.0",
    "@fontsource/inter": "^5.3.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "knip": "^6.41.0",
    "markdown-it": "^15.0.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
